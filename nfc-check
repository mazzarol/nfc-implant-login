#!/usr/bin/python3
"""NFC implant PAM auth. Supports uid and dual modes."""
import os, sys, json, time

CONFIG = "/etc/nfc-auth.conf"
TIMEOUT = 15
POLL_INTERVAL = 0.15
DUAL_WINDOW = 10


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except Exception:
        return {}


def read_uid():
    from smartcard.System import readers
    from smartcard.util import toHexString
    r = readers()
    if not r: return None
    try:
        conn = r[0].createConnection()
        conn.connect()
        resp, sw1, sw2 = conn.transmit([0xFF, 0xCA, 0x00, 0x00, 0x00])
        conn.disconnect()
        if sw1 == 0x90 and sw2 == 0x00:
            return toHexString(resp).replace(" ", "").replace(":", "").upper()
    except: pass
    return None


def main():
    user = os.environ.get("PAM_USER", "")
    if not user: sys.exit(1)
    config = load_config()
    mode = config.get("mode", "uid")
    allowed_raw = config.get(user, [])
    allowed = [u.replace(" ", "").replace(":", "").upper() for u in allowed_raw]
    if not allowed: sys.exit(1)

    try:
        from smartcard.System import readers
        if not readers(): sys.exit(1)
    except: sys.exit(1)

    if mode == "uid":
        deadline = time.time() + TIMEOUT
        while time.time() < deadline:
            uid = read_uid()
            if uid and uid in allowed: sys.exit(0)
            time.sleep(POLL_INTERVAL)
        sys.exit(1)

    elif mode == "dual":
        deadline = time.time() + DUAL_WINDOW
        # Phase 1: detect first implant
        first = None
        while time.time() < deadline:
            uid = read_uid()
            if uid and uid in allowed:
                first = uid; break
            time.sleep(POLL_INTERVAL)
        if not first: sys.exit(1)
        # Phase 2: wait for removal
        while time.time() < deadline:
            uid = read_uid()
            if not uid or uid != first: break
            time.sleep(POLL_INTERVAL)
        # Phase 3: detect second
        while time.time() < deadline:
            uid = read_uid()
            if uid and uid in allowed and uid != first: sys.exit(0)
            time.sleep(POLL_INTERVAL)
        sys.exit(1)

    sys.exit(1)

if __name__ == "__main__":
    main()
