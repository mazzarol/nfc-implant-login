"""
NFC implant PAM auth. Fast-fail if reader missing.

Repository: https://github.com/mazzarol/nfc-host-login.git
NFC Implants: https://dangerousthings.com
Tested on: Ubuntu 24.04.4 LTS (Noble Numbat)
"""
import os, sys, json, time

CONFIG = "/etc/nfc-auth.conf"
TIMEOUT = 10
POLL_INTERVAL = 0.15

user = os.environ.get("PAM_USER", "")
if not user:
    sys.exit(1)

# Fast-fail if config missing or no UIDs for this user
try:
    with open(CONFIG) as f:
        config = json.load(f)
except Exception:
    sys.exit(1)

allowed = config.get(user, [])
if not allowed:
    sys.exit(1)
allowed = [uid.replace(" ", "").replace(":", "").upper() for uid in allowed]

# Fast-fail if reader not present (broken/unplugged)
try:
    from smartcard.System import readers
    from smartcard.util import toHexString
except Exception:
    sys.exit(1)

r = readers()
if not r:
    sys.exit(1)  # no delay — reader missing, fall to password

GET_UID = [0xFF, 0xCA, 0x00, 0x00, 0x00]
deadline = time.time() + TIMEOUT

while time.time() < deadline:
    try:
        conn = r[0].createConnection()
        conn.connect()
        resp, sw1, sw2 = conn.transmit(GET_UID)
        if sw1 == 0x90 and sw2 == 0x00:
            uid = toHexString(resp).replace(" ", "").replace(":", "").upper()
            if uid in allowed:
                sys.exit(0)
    except Exception:
        pass
    time.sleep(POLL_INTERVAL)

sys.exit(1)
