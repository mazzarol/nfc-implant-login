# NFC Implant Login - Session unlock daemon service
# Repository: https://github.com/mazzarol/nfc-host-login.git
# NFC Implants: https://dangerousthings.com

[Unit]
Description=NFC implant unlock daemon
After=pcscd.service graphical-session.target

[Service]
Type=simple
ExecStart=/home/peter/.local/bin/nfc-unlockd
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
