#!/usr/bin/python3
"""NFC implant daemon — tap to unlock, hold 2s to lock."""
import os, sys, json, time, subprocess

CONFIG = "/etc/nfc-auth.conf"
COOLDOWN = 3
HOLD_LOCK = 2.0  # seconds to hold implant to lock session


def get_allowed(user):
    try:
        with open(CONFIG) as f:
            config = json.load(f)
        uids = config.get(user, [])
        return [u.replace(" ", "").replace(":", "").upper() for u in uids]
    except Exception:
        return []


def is_locked():
    """Check if the current graphical session is locked."""
    try:
        # Get session list
        sid = subprocess.run(
            ["loginctl", "list-sessions", "--no-legend"],
            capture_output=True, text=True, timeout=3,
        )
        user = os.environ.get("USER", "peter")
        target = None
        # Prefer the graphical 'user'-class session (has a real TTY). The
        # 'manager' session (systemd user manager) has tty '-' and never locks;
        # on Ubuntu 26.04 it sorts first, so we must not pick it blindly.
        for line in sid.stdout.strip().split("\n"):
            parts = line.split()
            if len(parts) < 7:
                continue
            if parts[2] != user:
                continue
            if parts[5] == "user" and parts[6] != "-":
                target = parts[0]
                break
        # Fallback: any session for this user
        if not target:
            for line in sid.stdout.strip().split("\n"):
                parts = line.split()
                if len(parts) >= 4 and parts[2] == user:
                    target = parts[0]
                    break
        if not target:
            return False
        r = subprocess.run(
            ["loginctl", "show-session", target, "-p", "LockedHint", "--value"],
            capture_output=True, text=True, timeout=3,
        )
        return r.stdout.strip() == "yes"
    except Exception:
        return False


def main():
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "peter"
    allowed = get_allowed(user)
    if not allowed:
        print(f"No UIDs for {user}", file=sys.stderr)
        sys.exit(1)

    from smartcard.System import readers
    from smartcard.util import toHexString

    print("NFC daemon [tap=unlock, hold=lock]", flush=True)
    GET_UID = [0xFF, 0xCA, 0x00, 0x00, 0x00]
    last_action = 0

    # Hold tracking
    held_uid = None
    hold_start = 0

    while True:
        r = readers()
        if not r:
            time.sleep(2)
            continue

        uid = None
        try:
            conn = r[0].createConnection()
            conn.connect()
            resp, sw1, sw2 = conn.transmit(GET_UID)
            conn.disconnect()
            if sw1 == 0x90 and sw2 == 0x00:
                uid = toHexString(resp).replace(" ", "").replace(":", "").upper()
        except Exception as e:
            err = str(e)
            if "No smart card" not in err:
                print(f"Poll: {err}", file=sys.stderr, flush=True)

        now = time.time()

        if not uid or uid not in allowed:
            # No card or unknown card — reset hold tracking
            held_uid = None
            hold_start = 0
            time.sleep(0.5)
            continue

        # Known implant detected

        # Track continuous presence of same UID
        if uid == held_uid and hold_start > 0:
            # Same implant still present — check hold duration
            duration = now - hold_start
            if duration >= HOLD_LOCK:
                locked = is_locked()
                if not locked:
                    if now - last_action > COOLDOWN:
                        subprocess.run(["loginctl", "lock-session"], capture_output=True, timeout=5)
                        last_action = now
                        print(f"Locked: {uid} ({duration:.1f}s hold)", flush=True)
                held_uid = None
                hold_start = 0
        else:
            # New implant or first detection
            held_uid = uid
            hold_start = now
            locked = is_locked()
            if locked:
                # Screen is locked — instant unlock on tap
                subprocess.run(["loginctl", "unlock-session"], capture_output=True, timeout=5)
                print(f"Unlocked: {uid}", flush=True)
                held_uid = None
                hold_start = 0
            else:
                # Card detected while unlocked — tracking for hold-to-lock
                print(f"Seen: {uid} (unlocked, tracking hold)", flush=True)

        time.sleep(0.5)


if __name__ == "__main__":
    main()
